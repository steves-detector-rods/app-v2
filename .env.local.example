# Copy to .env.local and fill in. Snipcart provides "public test" + "live" keys.
# Start with the test key; switch to live before DNS flip.
NEXT_PUBLIC_SNIPCART_API_KEY=

# Formspree contact-form endpoint (https://formspree.io/f/xxxxxxxx)
NEXT_PUBLIC_FORMSPREE_ENDPOINT=

# GA4 measurement ID (G-XXXXXXX)
NEXT_PUBLIC_GA_ID=

# Newsletter (one of: buttondown | mailchimp | convertkit — default buttondown)
NEXT_PUBLIC_NEWSLETTER_PROVIDER=buttondown
NEWSLETTER_API_KEY=
